# Copie este arquivo para ".env" (na mesma pasta do manage.py) e preencha
# com a sua chave. Sem isso, o tutor só responde perguntas que já estão
# nas regras/Q&A cadastradas — perguntas novas caem no motor de IA (Groq)
# e precisam da chave abaixo para funcionar.

# Chave da API da Groq (https://console.groq.com/keys)
GROQ_API_KEY=

# Opcional — usada se o Django exigir uma SECRET_KEY própria em produção.
SECRET_KEY=
